RESEND_API_KEY=your_resend_api_key
EMAIL_FROM="One Small Seed <verified-sender@example.com>"

# Separate server-only Contact form delivery. Do not reuse the quiz key.
CONTACT_RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Client-safe Supabase publishable configuration. The existing project values
# remain the runtime fallback during migration.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_publishable_anon_key

# Server-only YouTube Data API credential for the Resources page.
YOUTUBE_API_KEY=
